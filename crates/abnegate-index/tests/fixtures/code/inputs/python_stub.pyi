from typing import Iterable, Optional, overload

class Ledger:
    name: str
    balance: float
    def __init__(self, name: str, opening: float = ...) -> None: ...
    def credit(self, amount: float, memo: Optional[str] = ...) -> float: ...
    def debit(self, amount: float, memo: Optional[str] = ...) -> float: ...
    @overload
    def history(self) -> list: ...
    @overload
    def history(self, limit: int) -> list: ...

def open_ledgers(names: Iterable[str]) -> list: ...
def reconcile(left: Ledger, right: Ledger, tolerance: float = ...) -> bool: ...
